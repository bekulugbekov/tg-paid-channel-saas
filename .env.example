# Server
NODE_ENV=development
PORT=3000
# Webhook URL (production only). Leave empty for long-polling (dev)
PUBLIC_URL=

# Telegram
BOT_TOKEN=
BOT_USERNAME=

# Database
# For Supabase: use Transaction pooler (port 6543) with ?pgbouncer=true&connection_limit=1
# For local Docker: postgresql://saas:saas_pass@localhost:5432/tg_saas
DATABASE_URL=
# Direct connection for Prisma migrations (Supabase: db.[ref].supabase.co:5432)
DIRECT_URL=

# Security
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Dashboard
DASHBOARD_URL=http://localhost:5173

# Platform admin Telegram ID (for /testsub command)
ADMIN_TELEGRAM_ID=
