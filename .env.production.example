# ═══════════════════════════════════════════════════════════════════════════════
# Production environment variables — copy to .env.production and fill in values
# NEVER commit .env.production to git
# ═══════════════════════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Public HTTPS URL (no trailing slash). Must match your Caddyfile domain.
# Used for: Telegram webhook URL, magic link dashboard URL
PUBLIC_URL=https://yourdomain.com

# ── Telegram ─────────────────────────────────────────────────────────────────
# Get from @BotFather
BOT_TOKEN=

# Bot username without @, used for deep links: t.me/<BOT_USERNAME>?start=c_...
BOT_USERNAME=

# ── Database ─────────────────────────────────────────────────────────────────
# Internal Docker network connection (postgres = service name in docker-compose.prod.yml)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# For Prisma migrations (same as DATABASE_URL for Docker; for Supabase use direct connection)
DIRECT_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ── PostgreSQL container credentials ─────────────────────────────────────────
# Used by postgres service in docker-compose.prod.yml
POSTGRES_USER=saas
POSTGRES_PASSWORD=
POSTGRES_DB=tg_saas

# ── Security ─────────────────────────────────────────────────────────────────
# JWT signing secret (≥32 chars, random)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# AES-256-GCM key for encrypting Payme/Click merchant credentials (exactly 64 hex chars = 32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️  BACK THIS UP SEPARATELY — losing it means merchant credentials become unreadable
ENCRYPTION_KEY=

# ── Dashboard ────────────────────────────────────────────────────────────────
# Should match PUBLIC_URL in production (Express serves dashboard from same origin)
DASHBOARD_URL=https://yourdomain.com

# ── Admin ────────────────────────────────────────────────────────────────────
# Your Telegram numeric ID (get from @userinfobot)
# Grants access to /api/admin/* and Admin panel in dashboard
ADMIN_TELEGRAM_ID=
